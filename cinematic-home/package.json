{
  "name": "wulf-cinematic-home",
  "private": true,
  "version": "0.1.0",
  "description": "Cinematic, scroll-directed homepage for Wulf Diamond Jewelers: a code-built 3D ring with a ray-traced diamond.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "pictures": "node tools/assets.mjs all && node build.mjs",
    "lab": "esbuild src/lab.js --bundle --format=iife --outfile=tools/lab.js"
  },
  "dependencies": {
    "esbuild": "0.25.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.183.2",
    "three-mesh-bvh": "0.9.16"
  }
}
